# Prevent script execution in settings upload directory
Options -Indexes -ExecCGI

# Block execution of all script files
<FilesMatch "(?i)\.(php|phtml|php3|php4|php5|php7|php8|phps|pht|cgi|pl|py|sh|asp|aspx|exe|cmd|bat)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Allow,Deny
        Deny from all
    </IfModule>
</FilesMatch>

# Force default static file handling
<IfModule mod_mime.c>
    RemoveHandler .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
    RemoveType .php .phtml .php3 .php4 .php5 .php7 .php8 .phps
</IfModule>

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>
